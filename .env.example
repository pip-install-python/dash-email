# Resend API for sending emails
# Get your API key at: https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Google Gemini API for AI email generation — OPTIONAL.
# Without it the app still boots and /email-builder runs in "showcase mode",
# serving the curated examples in utils/showcase_templates.py instead of
# generating templates with AI.
# Get your API key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
# Alternative name (also supported)
# GEMINI_API_KEY=your_gemini_api_key_here

# Wide Events Logging Mode
# Options:
#   debug - 100% of events, pretty JSON output (recommended for development)
#   tail  - Tail-based sampling: 100% errors/slow, 5% success (recommended for production)
#   none  - Disable wide events logging
# Default: debug if DEBUG=true, otherwise tail
LOGGER_MODE=debug

# Debug mode (enables verbose logging)
# DEBUG=true

# 2plot.dev ad network (lib/ad_client.py) — both optional; defaults shown.
# AD_SERVER_URL=https://2plot.dev
# AD_APP_ID=dash-email
